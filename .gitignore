# Visual Studio / Rider generated files
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.xcworkspace
*.xcodeproj
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.tlog

# Compiled Object files
*.slo
*.lo
*.o
*.obj
*.pch
*.pch.hpp
*.pch.cpp

# Precompiled Headers
*.gch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa
*.apk

# Binaries and build outputs
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/Autosaves/
Saved/Backup/
Saved/Cooked/
Saved/Logs/
Saved/Sandboxes/
Saved/StagedBuilds/
Saved/UnrealBuildTool/
Saved/Collections/
Saved/Config/CrashReportClient/
Saved/Config/WorldState/
Saved/Crashes/
Saved/Demo/
Saved/Profil
Saved/Script/
Saved/ShaderDebugInfo/
Saved/SourceControl/
Saved/VideoCaptures/

# Don't ignore the actual game .exe icon, but ignore generated binaries
# (Binaries/ above already handles this)

# Configuration files generated by the engine
*.generated.*
*.pri

# Plugin intermediates
Plugins/*/Binaries/
Plugins/*/Intermediate/
Plugins/*/DerivedDataCache/

# macOS / Linux files
.DS_Store
*.swp
*.lock

# Ignore large data files and raw assets that should be managed elsewhere
*.psd
*.raw
*.fbx
*.wav
*.mp3
*.mp4
*.avi

# Keep important config and source files — do not ignore:
# Config/
# Content/
# Source/
# *.uproject
